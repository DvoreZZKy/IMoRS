<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <Border Background="White"></Border>
        </Border>
    </Design.PreviewWith>

    <Style Selector="Border.Tile">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="#A0000000" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="BorderBrush" Value="#FF5500AA" />
    </Style>
    <Style Selector="Border.TopTile">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="#A0000000" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="BorderBrush" Value="#FF5500AA" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Margin" Value="0, 0, 8, 1" />
    </Style>
    <Style Selector="Border.Overlay">
        <Setter Property="Background" Value="#A0000000" />
    </Style>
    <Style Selector="Button.ButtonTop">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="37" />
        <Setter Property="Background" Value="#262626" />
        <Setter Property="Margin" Value="0, 0, -2, 0" />
        <Style Selector="^:pointerover /template/ContentPresenter">
            <Setter Property="Background" Value="#FF5500AA" />
        </Style>
        <Style Selector="^:pressed /template/ContentPresenter">
            <Setter Property="Background" Value="#5c1e9c" />
        </Style>
    </Style>
    <Style Selector="Button.CloseButton">
        <Setter Property="Background" Value="#262626" />
        <Setter Property="Margin" Value="0, 0, -1, 0" />
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="37" />
        <Setter Property="CornerRadius" Value="0, 5, 5, 0" />

        <Style Selector="^:pointerover /template/ContentPresenter">
            <Setter Property="Background" Value="Red" />
        </Style>
        <Style Selector="^:pressed /template/ContentPresenter">
            <Setter Property="Background" Value="#5c1e9c" />
        </Style>
    </Style>
    <Style Selector="Image.ButtonImage">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ControlButton">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="StackPanel.StackButtonControl">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="10" />
    </Style>
    <Style Selector="Button.SideButton">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition
                    Property="RenderTransform"
                    Duration="0:0:0.15" />
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05)" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Style>
    <Style Selector="Button.EditIconButton">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity"
                                  Duration="0:0:0.5" />
            </Transitions>
        </Setter>
        <Setter Property="Margin" Value="70" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style Selector="^:pointerover /template/ContentPresenter">
            <Setter Property="Background" Value="#FF5500AA" />
        </Style>
        <Style Selector="^:pressed /template/ContentPresenter">
            <Setter Property="Background" Value="#5c1e9c" />
        </Style>
    </Style>
    <Style Selector="Button.GradientButton">
        <Setter Property="Background" Value="#FF4F1899" />
        <Style Selector="^:pointerover /template/ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="100%,30%" EndPoint="0%,0%">
                    <GradientStop Color="#FF4F1899" Offset="0" />
                    <GradientStop Color="#FFA71DFF" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="^:pressed /template/ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="100%,30%" EndPoint="0%,0%">
                    <GradientStop Color="#FF6F1899" Offset="0" />
                    <GradientStop Color="#FFB71CFF" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="^:disable /template/ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="100%,30%" EndPoint="0%,0%">
                    <GradientStop Color="#FFB71CFF" Offset="0" />
                    <GradientStop Color="#FF6F1899" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
    </Style>
    <Style Selector="Border.ConfirmDeleteDialog">

    </Style>
    <Style Selector="Border.GradientBorderBrush">
        <Setter Property="BorderBrush">
            <LinearGradientBrush StartPoint="100%,30%" EndPoint="0%,0%">
                <GradientStop Color="#FFB71CFF" Offset="0" />
                <GradientStop Color="#FF6F1899" Offset="0.5" />
                <GradientStop Color="#FF4F1899" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>
    <Style Selector="TextBox.DescBox">
        <Setter Property="Background">
            <RadialGradientBrush Center="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#FFA71DFF" Offset="0" />
                <GradientStop Color="#FF4F1899" Offset="1" />
            </RadialGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Watermark" Value="Придумайте описание..." />
        <Setter Property="AcceptsReturn" Value="True" />
    </Style>
    <Style Selector="TextBlock.DescBlock">
        <Setter Property="Background">
            <RadialGradientBrush Center="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#FFA71DFF" Offset="0" />
                <GradientStop Color="#FF4F1899" Offset="1" />
            </RadialGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Slider.Neon">
        <Style Selector="^ Thumb">
            <Setter Property="Background" Value="#FFA71DFF"/>
            <Setter Property="BorderBrush" Value="#FF4F1899"/>
        </Style>
    </Style>
</Styles>